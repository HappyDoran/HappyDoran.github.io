---
interface Props {
  description?: string;
  title: string;
  type?: "article" | "website";
}
const {
  description = "Notion에서 게시한 기록입니다.",
  title,
  type = "website",
} = Astro.props;
import { base, pathFor, site, siteOwner } from "../lib/blog";

const siteName = site.title;
const githubUrl = "https://github.com/" + siteOwner;
const pathname = Astro.url.pathname;
const section = pathname === base
  ? "home"
  : pathname.startsWith(pathFor("posts/"))
    ? "posts"
    : undefined;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title === "홈" ? siteName : title + " · " + siteName}</title>
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title === "홈" ? siteName : title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href={pathFor("rss.xml")} />
    <!-- 제목 글꼴(디자인 기획 10.2, 결정 D5). 받지 못해도 시스템 명조로 읽힌다. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hahmlet:wght@700&display=swap" />
    <style is:global>
:root {
  --color-bg-canvas: #ffffff;
  --color-bg-surface: #ffffff;
  --color-bg-column: #f3f8fc;
  --color-bg-selected: #e6f1fa;
  --color-text-primary: #16181d;
  --color-text-secondary: #586070;
  --color-border: #cdd3db;
  --color-border-strong: #16181d;
  --color-accent: #16181d;
  --color-accent-hover: #3a3f4a;
  --color-guide: #8ec3ea;
  --color-guide-soft: #e6f1fa;
  --color-guide-text: #2f6e9e;
  --color-proof: #c2185b;
  --color-focus: #2f6e9e;
  --color-success: #1a7a43;
  --color-danger: #a3161a;
  --color-warning-bg: #fff4d6;
  --radius-control: 0;
  --radius-card: 0;
  --radius-column: 0;
  --shadow-dialog: 0 16px 48px rgb(22 24 29 / 18%);
  --ease: cubic-bezier(0.2, 0.8, 0.2, 1);
  --shell-max: 76rem;
  --reading-max: 45rem;
  --toc-width: 13.75rem;
}
      :root {
        --font-title: "Hahmlet", "Noto Serif KR", "AppleMyungjo", "Batang", serif;
        --font-sans: system-ui, -apple-system, "Apple SD Gothic Neo", sans-serif;
        --font-mono: ui-monospace, SFMono-Regular, Menlo, monospace;
        color: var(--color-text-primary);
        background: var(--color-bg-surface);
        font-family: var(--font-sans);
      }
      * { box-sizing: border-box; }
      html { overflow-wrap: anywhere; word-break: keep-all; }
      body { min-width: 20rem; margin: 0; line-height: 1.6; }
      a { color: var(--color-accent); text-underline-offset: 0.2em; }
      a:hover { color: var(--color-accent-hover); }
      a:focus-visible, summary:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
      h1, h2, h3, h4 { line-height: 1.3; }
      .skip-link { position: fixed; z-index: 10; inset: 0 auto auto 0; padding: 0.75rem 1rem; transform: translateY(-120%); background: var(--color-text-primary); color: #ffffff; }
      .skip-link:focus { transform: translateY(0); }

.site-header { border-bottom: 1px solid var(--color-border); background: var(--color-bg-surface); }
.site-header-inner, .site-main, .site-footer-inner { width: min(var(--shell-max), calc(100% - 2.5rem)); margin-inline: auto; }
.site-header-inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 1.5rem; min-height: 3.5rem; padding-block: 0.5rem; }
.site-brand { color: var(--color-text-primary); font-family: var(--font-title); font-size: 1.0625rem; font-weight: 700; text-decoration: none; }
.site-nav ul, .tag-list, .breadcrumbs ol, .category-list { display: flex; flex-wrap: wrap; margin: 0; padding: 0; list-style: none; }
.site-nav ul { gap: 0.25rem; }
.site-nav a { display: inline-flex; min-height: 2.75rem; align-items: center; padding-inline: 0.75rem; border-radius: var(--radius-control); color: var(--color-text-secondary); font-size: 0.875rem; font-weight: 500; text-decoration: none; }
.site-nav a:hover { color: var(--color-text-primary); }
.site-nav a[aria-current="page"], .site-brand[aria-current="page"] { color: var(--color-accent); }
/* 글 상세의 목차 배치는 화면이 아니라 본문 영역 폭으로 정한다(앱 프리뷰의 좁은 프레임에서도 같게). */
.site-main { min-height: 70vh; padding-block: 2.5rem 4rem; container-type: inline-size; }
.site-footer { border-top: 1px solid var(--color-border); color: var(--color-text-secondary); }
.site-footer-inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 1.5rem; padding-block: 1.5rem; font-size: 0.875rem; }
.muted { color: var(--color-text-secondary); }

.hero { max-width: var(--reading-max); margin-block-end: 3rem; }
.hero h1 { margin: 0 0 0.75rem; font-family: var(--font-title); font-size: clamp(1.75rem, 4vw, 2.125rem); line-height: 1.3; }
.hero p { margin: 0; color: var(--color-text-secondary); }
.hero-links { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; margin: 0.75rem 0 0; padding: 0; list-style: none; font-size: 0.875rem; }
.hero-links a { display: inline-flex; min-height: 2.75rem; align-items: center; }
.hero-stats { display: flex; gap: 1rem; margin: 1rem 0 0; font-family: var(--font-mono); font-size: 0.8125rem; color: var(--color-text-secondary); }
.hero-stats div { display: flex; gap: 0.35rem; }
.hero-stats dd { margin: 0; color: var(--color-text-primary); }
.section-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem 1rem; margin-block: 2.5rem 1rem; }
.section-heading h2 { margin: 0; font-size: 1.125rem; }
.post-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 28rem), 1fr)); gap: 1rem; }
.post-list { display: grid; gap: 1rem; }
/* 읽기 폭 블록은 화면 가운데에 둔다(글 상세 본문 열과 같은 세로선). */
.breadcrumbs, .page-intro, .post-list, .archive-month, .empty-state, .post-search, .post-status, .tag-filter, .pagination { max-width: var(--reading-max); margin-inline: auto; }
.post-search { display: grid; gap: 0.375rem; margin-block-end: 1rem; }
.post-search label { font-size: 0.875rem; font-weight: 600; }
.post-search input { min-height: 2.75rem; padding-inline: 0.875rem; border: 1px solid var(--color-border-strong); border-radius: var(--radius-control); background: var(--color-bg-surface); color: var(--color-text-primary); font: inherit; }
.post-search input:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
.tag-filter { display: grid; justify-items: start; gap: 0.5rem; margin-block-end: 1.5rem; }
.tag-filter [hidden] { display: none; }
.tag-more { min-height: 2.75rem; padding: 0 0.25rem; border: 0; background: none; color: var(--color-accent); font: inherit; font-size: 0.875rem; text-decoration: underline; text-underline-offset: 0.2em; cursor: pointer; }
.tag-more:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
.post-status { margin-block: 0 1rem; font-size: 0.875rem; }
.pagination { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.375rem; margin-block-start: 2rem; }
.pagination button { min-width: 2.75rem; min-height: 2.75rem; padding-inline: 0.75rem; border: 1px solid var(--color-border-strong); border-radius: var(--radius-control); background: var(--color-bg-surface); color: var(--color-text-primary); font: inherit; font-family: var(--font-mono); font-size: 0.875rem; cursor: pointer; }
.pagination button:hover:not(:disabled) { border-color: var(--color-accent); color: var(--color-accent); }
.pagination button[aria-current="page"] { border-color: var(--color-accent); background: var(--color-accent); color: var(--color-bg-surface); font-weight: 700; cursor: default; }
.pagination button:disabled { cursor: default; opacity: 0.45; }
.pagination button:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }

.post-card { position: relative; display: flex; min-width: 0; flex-direction: column; gap: 0.5rem; padding: 1.25rem; border: 1px solid var(--color-border); border-radius: var(--radius-card); background: var(--color-bg-surface); transition: border-color 120ms var(--ease); }
.post-card:hover, .post-card:focus-within { border-color: var(--color-accent); }
.post-card-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 0.75rem; color: var(--color-text-secondary); font-family: var(--font-mono); font-size: 0.75rem; }
.post-card h2, .post-card h3 { margin: 0; font-family: var(--font-title); font-size: 1.125rem; line-height: 1.4; }
.post-card-title { color: var(--color-text-primary); text-decoration: none; }
.post-card-title:hover { color: var(--color-accent); text-decoration: underline; }
/* 카드 전체가 글 링크다. 제목 링크를 카드 크기로 늘리고, 태그 링크만 그 위에 둔다. */
.post-card-title::after { position: absolute; inset: 0; border-radius: var(--radius-card); content: ""; }
.post-card-title:focus-visible { outline: none; }
.post-card:has(.post-card-title:focus-visible) { outline: 2px solid var(--color-focus); outline-offset: 2px; }
.post-card:hover .post-card-title { color: var(--color-accent); }
.post-card .tag-list { position: relative; z-index: 1; }
.post-card-description { display: -webkit-box; overflow: hidden; margin: 0; color: var(--color-text-secondary); -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.tag-list { gap: 0.25rem 0.75rem; color: var(--color-text-secondary); font-family: var(--font-mono); font-size: 0.75rem; }
.tag-list li { white-space: nowrap; }
.tag-list a { color: inherit; text-decoration: none; }
.tag-list a:hover { color: var(--color-accent); text-decoration: underline; }
.archive-month { margin-block-end: 2rem; }
.archive-month h2 { margin: 0 0 0.5rem; font-size: 1.125rem; }
.archive-list { margin: 0; padding: 0; list-style: none; }
.archive-list li { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; padding-block: 0.5rem; border-bottom: 1px solid var(--color-border); }
.archive-list time { min-width: 8.5rem; color: var(--color-text-secondary); font-family: var(--font-mono); font-size: 0.8125rem; }
.category-list { gap: 0.5rem; }
.category-list a { display: inline-flex; min-height: 2.75rem; align-items: center; gap: 0.5rem; padding-inline: 0.875rem; border: 1px solid var(--color-border-strong); border-radius: var(--radius-control); background: var(--color-bg-surface); color: var(--color-text-primary); text-decoration: none; }
.category-list a:hover, .category-list a[aria-current] { border-color: var(--color-accent); color: var(--color-accent); }
.category-list .muted { font-family: var(--font-mono); font-size: 0.75rem; }

.breadcrumbs { margin-block-end: 1.5rem; color: var(--color-text-secondary); font-family: var(--font-mono); font-size: 0.75rem; }
.breadcrumbs ol { gap: 0.4rem; }
.breadcrumbs li { display: flex; gap: 0.4rem; }
.breadcrumbs a { color: inherit; }
.page-intro { margin-block-end: 2rem; }
.page-intro h1, .post-header h1 { margin: 0 0 0.5rem; font-family: var(--font-title); font-size: clamp(1.75rem, 4vw, 2.125rem); line-height: 1.3; }
.page-intro p { margin: 0; }
.empty-state { padding: 1.5rem; border: 1px solid var(--color-border); border-radius: var(--radius-card); background: var(--color-bg-surface); }
.empty-state :is(h1, h2) { margin-block-start: 0; font-size: 1.25rem; }

.post-header { margin-block-end: 2rem; padding-block-end: 1.25rem; border-bottom: 1px solid var(--color-text-primary); }
.post-header h1 { margin-block-start: 0; }
.post-meta { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; color: var(--color-text-secondary); font-family: var(--font-mono); font-size: 0.8125rem; }
.post-header .tag-list { margin-block-start: 0.75rem; }
/* 글 상세: 제목 → 목차 → 본문 순서. 본문 열은 늘 가운데이고, 넓으면 목차를 본문 왼쪽 빈자리에 둔다. */
.article-layout { display: grid; grid-template-columns: minmax(0, var(--reading-max)); justify-content: center; }
.article-layout > * { min-width: 0; }
/* 목차는 교정지 여백의 방주처럼 연필 파랑 선 옆에 둔다. */
.post-toc { margin-block-end: 2rem; padding: 0.25rem 0 0.25rem 1rem; border-inline-start: 1px solid var(--color-guide); font-size: 0.875rem; }
.post-toc h2 { margin: 0 0 0.5rem; color: var(--color-guide-text); font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.04em; }
.post-toc ol { margin: 0; padding-inline-start: 1.1rem; }
.post-toc a { color: var(--color-text-secondary); text-decoration: none; }
.post-toc a:hover { color: var(--color-accent); text-decoration: underline; }

.post-body { overflow-wrap: anywhere; font-size: 1rem; line-height: 1.75; }
.post-body > :first-child { margin-block-start: 0; }
.post-body p, .post-body ul, .post-body ol { margin-block: 0.75rem; }
.post-body ul, .post-body ol { padding-inline-start: 1.5rem; }
.post-body li + li { margin-block-start: 0.25rem; }
.post-body a { color: var(--color-accent); text-decoration: underline; text-underline-offset: 0.2em; }
.post-body h2, .post-body h3, .post-body h4, .post-body h5 { line-height: 1.3; text-wrap: balance; }
.post-body h2, .post-body h3 { font-family: var(--font-title); }
.post-body h2 { margin-block: 2.5rem 0.75rem; font-size: clamp(1.55rem, 3vw, 1.9rem); }
.post-body h3 { margin-block: 2rem 0.75rem; font-size: clamp(1.3rem, 2.5vw, 1.55rem); }
.post-body h4 { margin-block: 1.5rem 0.5rem; font-size: clamp(1.18rem, 2vw, 1.3rem); }
.post-body h5 { margin-block: 1.25rem 0.5rem; font-size: 1.1rem; }
.post-body code { font-family: var(--font-mono); font-size: 0.875em; }
.post-body :not(pre) > code { padding: 0.1em 0.3em; border-radius: 4px; background: var(--color-bg-canvas); }
.post-body pre { max-width: 100%; overflow-x: auto; padding: 1rem; border: 1px solid var(--color-border); border-radius: var(--radius-control); background: var(--color-bg-canvas); line-height: 1.6; }
.post-body blockquote { margin-inline: 0; padding-inline-start: 1rem; border-inline-start: 3px solid var(--color-border-strong); color: var(--color-text-secondary); }
.post-body hr { margin-block: 2rem; border: 0; border-top: 1px solid var(--color-border); }
.post-body img { display: block; max-width: 100%; height: auto; margin: 1.5rem auto; border-radius: var(--radius-control); }
.post-body figure { margin: 1.5rem 0; }
.post-body figcaption { margin-block-start: 0.5rem; color: var(--color-text-secondary); font-size: 0.875rem; text-align: center; }
.post-body input[type="checkbox"] { width: 1rem; height: 1rem; margin-inline: 0 0.5rem; accent-color: var(--color-accent); }
.post-body .notion-table-wrap { max-width: 100%; margin-block: 1.5rem; overflow-x: auto; }
.post-body table { width: 100%; min-width: 28rem; border-collapse: collapse; font-size: 0.9375rem; }
.post-body th, .post-body td { padding: 0.5rem 0.75rem; border: 1px solid var(--color-border); text-align: start; vertical-align: top; }
.post-body th { background: var(--color-bg-canvas); font-weight: 600; }
.post-body .notion-equation { max-width: 100%; margin-block: 1.25rem; padding: 0.75rem 1rem; overflow-x: auto; border: 1px solid var(--color-border); border-radius: var(--radius-control); text-align: center; }
.post-body .notion-resource-card { display: grid; gap: 0.2rem; margin-block: 0.75rem; padding: 0.75rem 1rem; border: 1px solid var(--color-border); border-radius: var(--radius-card); background: var(--color-bg-surface); color: var(--color-text-primary); text-decoration: none; }
.post-body a.notion-resource-card:hover { border-color: var(--color-accent); }
.post-body .notion-resource-label { color: var(--color-text-secondary); font-family: var(--font-mono); font-size: 0.75rem; }
.post-body details { margin-block: 1rem; padding: 0.5rem 1rem; border: 1px solid var(--color-border); border-radius: var(--radius-control); }
.post-body summary { min-height: 2.75rem; align-content: center; cursor: pointer; font-weight: 600; }
.post-navigation { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-block-start: 3rem; padding-block-start: 1.5rem; border-top: 1px solid var(--color-border); }
.post-navigation a { display: block; padding-block: 0.5rem; text-decoration: none; }
.post-navigation small { display: block; color: var(--color-text-secondary); font-family: var(--font-mono); font-size: 0.75rem; }
.post-navigation .next { text-align: end; }
.home-link { margin-block: 2rem 0; }
/* 글 끝: (끝)과 판권(디자인 기획 2.4·11). */
.post-end { margin: 2.5rem 0 0; color: var(--color-text-secondary); font-family: var(--font-title); font-weight: 700; text-align: end; }
.post-colophon { margin-block-start: 1.5rem; padding-block: 0.875rem 1rem; border-top: 2px solid var(--color-text-primary); border-bottom: 1px solid var(--color-text-primary); }
.post-colophon h2 { margin: 0 0 0.5rem; font-family: var(--font-title); font-size: 0.9375rem; }
.post-colophon dl { display: grid; gap: 0.25rem; margin: 0; font-size: 0.875rem; }
.post-colophon dl > div { display: grid; grid-template-columns: 6rem minmax(0, 1fr); gap: 1rem; }
.post-colophon dt { color: var(--color-text-secondary); font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.04em; line-height: 1.9; }
.post-colophon dd { margin: 0; }

@media (min-width: 37.5rem) {
  .site-header-inner, .site-main, .site-footer-inner { width: min(var(--shell-max), calc(100% - 4rem)); }
}
/* 본문 45rem + 양쪽 목차 자리(약 12.5rem)와 간격이 들어가는 폭부터 목차를 옆에 둔다. 그보다 좁으면 본문 위다. */
@container (min-width: 76rem) {
  .article-layout.with-toc { grid-template-columns: minmax(0, 1fr) minmax(0, var(--reading-max)) minmax(0, 1fr); justify-content: stretch; column-gap: 3rem; align-items: start; }
  .article-layout.with-toc > .post-header, .article-layout.with-toc > .article-main { grid-column: 2; }
  .article-layout.with-toc > .post-toc { position: sticky; top: 1.5rem; grid-column: 1; grid-row: 2; justify-self: end; width: min(100%, var(--toc-width)); max-height: calc(100vh - 3rem); margin: 0; overflow-y: auto; }
  .article-layout.with-toc > .article-main { grid-row: 2; }
}
@media (max-width: 37.4375rem) {
  /* 좁은 화면의 태그는 한 줄로 두고 옆으로 민다. 모든 태그를 넣고 더 보기는 쓰지 않는다. 오른쪽 끝을 흐려 더 있음을 알린다. */
  .tag-filter { justify-items: stretch; }
  .tag-filter .category-list { min-width: 0; flex-wrap: nowrap; overflow-x: auto; padding-block-end: 0.25rem; padding-inline-end: 2rem; scrollbar-width: none; -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 2rem), transparent); mask-image: linear-gradient(to right, #000 calc(100% - 2rem), transparent); }
  .tag-filter .category-list::-webkit-scrollbar { display: none; }
  .tag-filter .category-list li { flex: none; }
  .tag-filter li[hidden] { display: block; }
  .tag-filter .tag-more { display: none; }
  .post-navigation { grid-template-columns: 1fr; }
  .post-navigation .next { text-align: start; }
}
@media (prefers-reduced-motion: reduce) {
  .post-card { transition: none; }
}
@media (prefers-contrast: more) {
  .post-card, .category-list a, .post-toc, .empty-state, .post-search input, .pagination button { border-color: var(--color-text-primary); }
}

    </style>
  </head>
  <body>
    <a class="skip-link" href="#main-content">본문으로 건너뛰기</a>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="site-brand" href={base} aria-current={section === "home" ? "page" : undefined}>{siteName}</a>
        <nav class="site-nav" aria-label="주요 탐색">
          <ul>
            <li><a href={pathFor("posts/")} aria-current={section === "posts" ? "page" : undefined}>전체 글</a></li>
            <li><a href={githubUrl} rel="me">GitHub</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main class="site-main" id="main-content"><slot /></main>
    <footer class="site-footer">
      <div class="site-footer-inner">
        <span>© {new Date().getUTCFullYear()} {siteOwner} · GitHub Pages로 게시됨</span>
        <span><a href={pathFor("archive/")}>보관함</a></span>
      </div>
    </footer>
  </body>
</html>
